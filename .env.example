# ==============================================================================
# Kasnet Online Internship Portal - Sample Environment Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (e.g. cp .env.example .env)
# 2. Fill in your MySQL database credentials and Groq API key below.
# 3. For cloud deployments (Docker, Render, AWS, Heroku), you can also set these
#    directly as OS environment variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL)
# ------------------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/online_internship?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# ------------------------------------------------------------------------------
# 2. GROQ CLOUD AI CONFIGURATION (Resume & Skill Gap Analysis)
# ------------------------------------------------------------------------------
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
