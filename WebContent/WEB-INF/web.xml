<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1"
         metadata-complete="true">

    <display-name>My Internship Technologies Portal</display-name>

    <!-- ======================== CONTEXT PARAMETERS ======================== -->
    <context-param>
        <param-name>uploadDir</param-name>
        <param-value>/uploads</param-value>
    </context-param>
    <context-param>
        <param-name>maxFileSizeMB</param-name>
        <param-value>5</param-value>
    </context-param>
    <context-param>
        <param-name>assignmentInstructionsUploadDir</param-name>
        <param-value>uploads</param-value>
    </context-param>
    <context-param>
        <param-name>javax.servlet.jsp.jstl.fmt.timeZone</param-name>
        <param-value>Asia/Kolkata</param-value>
    </context-param>

    <!-- ======================== SERVLETS ======================== -->

    <!-- Login -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.kasnet.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- Register -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.kasnet.controller.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <!-- Logout -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.kasnet.controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- home -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.kasnet.controller.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/Home</url-pattern>
    </servlet-mapping>
    <!-- Dashboard -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.kasnet.controller.DashboardServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <!-- Profile -->
    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.kasnet.controller.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>

    <!-- Personal Details -->
    <servlet>
        <servlet-name>PersonalDetailsServlet</servlet-name>
        <servlet-class>com.kasnet.controller.PersonalDetailsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PersonalDetailsServlet</servlet-name>
        <url-pattern>/personal-details</url-pattern>
    </servlet-mapping>

    <!-- Education -->
    <servlet>
        <servlet-name>EducationServlet</servlet-name>
        <servlet-class>com.kasnet.controller.EducationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EducationServlet</servlet-name>
        <url-pattern>/education</url-pattern>
    </servlet-mapping>

    <!-- Engineering Marks -->
    <servlet>
        <servlet-name>EngineeringMarksServlet</servlet-name>
        <servlet-class>com.kasnet.controller.EngineeringMarksServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EngineeringMarksServlet</servlet-name>
        <url-pattern>/engineering-marks</url-pattern>
    </servlet-mapping>

    <!-- Achievements -->
    <servlet>
        <servlet-name>AchievementServlet</servlet-name>
        <servlet-class>com.kasnet.controller.AchievementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AchievementServlet</servlet-name>
        <url-pattern>/achievements</url-pattern>
    </servlet-mapping>

    <!-- Skills -->
    <servlet>
        <servlet-name>SkillsServlet</servlet-name>
        <servlet-class>com.kasnet.controller.SkillsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SkillsServlet</servlet-name>
        <url-pattern>/skills</url-pattern>
    </servlet-mapping>

    <!-- Certifications -->
    <servlet>
        <servlet-name>CertificationServlet</servlet-name>
        <servlet-class>com.kasnet.controller.CertificationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CertificationServlet</servlet-name>
        <url-pattern>/certifications</url-pattern>
    </servlet-mapping>

    <!-- Platform Exam Certificates -->
    <servlet>
        <servlet-name>PlatformCertificateServlet</servlet-name>
        <servlet-class>com.kasnet.controller.PlatformCertificateServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PlatformCertificateServlet</servlet-name>
        <url-pattern>/platform-certificates</url-pattern>
    </servlet-mapping>

    <!-- Student Project Reports -->
    <servlet>
        <servlet-name>PlatformProjectReportServlet</servlet-name>
        <servlet-class>com.kasnet.controller.PlatformProjectReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PlatformProjectReportServlet</servlet-name>
        <url-pattern>/platform-project-reports</url-pattern>
    </servlet-mapping>

    <!-- Projects -->
    <servlet>
        <servlet-name>ProjectServlet</servlet-name>
        <servlet-class>com.kasnet.controller.ProjectServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProjectServlet</servlet-name>
        <url-pattern>/projects</url-pattern>
    </servlet-mapping>

    <!-- Hackathons -->
    <servlet>
        <servlet-name>HackathonServlet</servlet-name>
        <servlet-class>com.kasnet.controller.HackathonServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HackathonServlet</servlet-name>
        <url-pattern>/hackathons</url-pattern>
    </servlet-mapping>

    <!-- Competitions -->
    <servlet>
        <servlet-name>CompetitionServlet</servlet-name>
        <servlet-class>com.kasnet.controller.CompetitionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CompetitionServlet</servlet-name>
        <url-pattern>/competitions</url-pattern>
    </servlet-mapping>

    <!-- Resume Upload -->
    <servlet>
        <servlet-name>ResumeUploadServlet</servlet-name>
        <servlet-class>com.kasnet.controller.ResumeUploadServlet</servlet-class>
        <multipart-config>
            <max-file-size>5242880</max-file-size>
            <max-request-size>5242880</max-request-size>
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResumeUploadServlet</servlet-name>
        <url-pattern>/resume-upload</url-pattern>
    </servlet-mapping>

    <!-- Assignments -->
    <servlet>
        <servlet-name>AssignmentServlet</servlet-name>
        <servlet-class>com.kasnet.controller.AssignmentServlet</servlet-class>
        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>11534336</max-request-size>
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>AssignmentServlet</servlet-name>
        <url-pattern>/assignments</url-pattern>
        <url-pattern>/assignment-details</url-pattern>
    </servlet-mapping>

    <!-- Admin assignment management and protected instruction PDFs -->
    <servlet>
        <servlet-name>AdminAssignmentServlet</servlet-name>
        <servlet-class>com.kasnet.controller.AdminAssignmentServlet</servlet-class>
        <multipart-config>
            <max-file-size>5242880</max-file-size>
            <max-request-size>6291456</max-request-size>
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminAssignmentServlet</servlet-name>
        <url-pattern>/admin/assignments</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>AssignmentInstructionPdfServlet</servlet-name>
        <servlet-class>com.kasnet.controller.AssignmentInstructionPdfServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AssignmentInstructionPdfServlet</servlet-name>
        <url-pattern>/assignment-instructions</url-pattern>
    </servlet-mapping>

    <!-- Lecture Videos -->
    <servlet>
        <servlet-name>LectureServlet</servlet-name>
        <servlet-class>com.kasnet.controller.LectureServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LectureServlet</servlet-name>
        <url-pattern>/lectures</url-pattern>
    </servlet-mapping>

    <!-- Admin -->
    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>com.kasnet.controller.AdminServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/admin</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminOfferLetterServlet</servlet-name>
        <servlet-class>com.kasnet.controller.AdminOfferLetterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminOfferLetterServlet</servlet-name>
        <url-pattern>/admin/offer-letter</url-pattern>
    </servlet-mapping>

    <!-- Question Bank -->
    <servlet>
        <servlet-name>QuestionBankServlet</servlet-name>
        <servlet-class>com.kasnet.controller.QuestionBankServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>QuestionBankServlet</servlet-name>
        <url-pattern>/question-bank</url-pattern>
    </servlet-mapping>

    <!-- Resume Analysis -->
    <servlet>
        <servlet-name>ResumeAnalysisServlet</servlet-name>
        <servlet-class>com.kasnet.controller.ResumeAnalysisServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResumeAnalysisServlet</servlet-name>
        <url-pattern>/resume-analysis</url-pattern>
    </servlet-mapping>

    <!-- ======================== WELCOME FILE ======================== -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <!-- ======================== ERROR PAGES ======================== -->
    <error-page>
        <error-code>404</error-code>
        <location>/views/error-404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/views/error-500.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/views/error-500.jsp</location>
    </error-page>

    <!-- ======================== SESSION CONFIG ======================== -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
